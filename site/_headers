# Cloudflare Pages headers for the published static output.
# CSP allows only what the site actually uses:
#   - self-hosted CSS, JS, fonts and images
#   - Formspree (form-action for native POST, connect-src for fetch)
#   - Cloudflare Web Analytics beacon (script + its reporting endpoint)
# Test on a preview deployment; adjust only when a resource is genuinely added.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://formspree.io https://cloudflareinsights.com; form-action 'self' https://formspree.io; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests

# Long-lived caching for static assets that change by filename (fonts, images,
# SVG). CSS/JS are small and referenced with a ?v= query string that is bumped
# on each release, so browsers must revalidate them on every visit.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/assets/img/*
  Cache-Control: public, max-age=31536000, immutable
/assets/svg/*
  Cache-Control: public, max-age=31536000, immutable
/css/*
  Cache-Control: public, max-age=0, must-revalidate
/js/*
  Cache-Control: public, max-age=0, must-revalidate
